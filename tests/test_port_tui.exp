#!/usr/bin/expect -f
set timeout 15
log_user 0
if {[info exists env(HUB_TEST_VERBOSE)]} { log_user 1 }
set root [lindex $argv 0]
set port [lindex $argv 1]
set pid [lindex $argv 2]
proc see {pattern} {
    expect {
        -glob $pattern { return }
        timeout { puts stderr "Port TUI timeout: $pattern"; exit 1 }
        eof { puts stderr "Port TUI exited before: $pattern"; exit 1 }
    }
}
# macOS PENDIN describes queued typeahead, rather than a persistent terminal mode.
spawn -noecho /usr/bin/env TERM=xterm-256color /bin/zsh -f -c {stty rows 32 cols 110; term_state() { local state=$(stty -a); print -r -- "${${state//-pendin/}//pendin/}"; }; saved=$(term_state); source "$1/lib/aliases.zsh"; eval pinfo; code=$?; [[ $(term_state) == $saved ]] || exit 99; exit $code} zsh $root $port
see {*端口管理*}
send -- "$port\r"
set seenPort 0
set seenPid 0
while {!$seenPort || !$seenPid} {
    expect {
        -re "(端口 $port|$pid)" {
            if {$expect_out(1,string) == "端口 $port"} { set seenPort 1 } else { set seenPid 1 }
        }
        timeout { puts stderr "Exact query did not show both local port and owned PID"; exit 1 }
        eof { puts stderr "Exact query exited early"; exit 1 }
    }
}
send -- "u"
see {*UDP*}
send -- "r"
see {*UDP*}
send -- "u"
see {*TCP*}
send -- "k"
see {*默认取消*}
send -- "\r"
see {*端口管理*}
if {[catch {exec /bin/kill -0 $pid}]} { puts stderr "Cancel terminated test process"; exit 1 }
send -- "k"
see {*默认取消*}
send -- "\016\r"
see {*原进程已退出*}
send -- "\033"
see {*端口管理*}
send -- "\033"
expect eof
set result [wait]
if {[lindex $result 3] != 0} { puts stderr "Port TUI exit: $result"; exit 1 }
puts "PASS: port TUI protocol switch, refresh, cancel, test-owned SIGTERM, terminal restore"

#!/usr/bin/expect -f
set timeout 15
log_user 0
if {[info exists env(HUB_TEST_VERBOSE)]} { log_user 1 }
set root [lindex $argv 0]
set native [lindex $argv 1]
set media [lindex $argv 2]
set archive [lindex $argv 3]
proc see {pattern} {
    expect {
        -glob $pattern { return }
        timeout { puts stderr "TUI timeout waiting for: $pattern"; exit 1 }
        eof { puts stderr "TUI exited before: $pattern"; exit 1 }
    }
}
proc finished {} {
    expect eof
    set result [wait]
    if {[lindex $result 3] != 0} { puts stderr "TUI exit: $result"; exit 1 }
}
spawn -noecho /usr/bin/env PATH=$native TERM=xterm-256color /bin/zsh -f -c {stty rows 32 cols 110; cd "$1/lib"; "$1/hub"} zsh $root
set terminal $spawn_out(slave,name)
see {*SHELL COMMAND HUB*}
send -- "d"
see {*vinfo*}
send -- "q"
see {*SHELL COMMAND HUB*}
send -- "/"
see {*搜索名称*}
send -- "port-info\r"
see {*端口进程管理*}
send -- "\r"
see {*端口管理*}
send -- "\033"
see {*SHELL COMMAND HUB*}
exec /bin/stty -f $terminal rows 12 cols 40
see {*48*}
exec /bin/stty -f $terminal rows 24 cols 80
see {*SHELL COMMAND HUB*}
send -- "q"
finished
spawn -noecho /usr/bin/env PATH=$native TERM=xterm-256color /bin/zsh -f -c {stty rows 32 cols 110; source "$1/lib/aliases.zsh"; eval 'vinfo "$2"'} zsh $root $media
see {*媒体信息*}
send -- "/no-such-hub-directory"
send -- "\t"
see {*操作菜单 · 按对应单键*}
send -- "r"
see {*媒体信息*}
send -- "WAV"
see {*格式：Wave*}
send -- "\033\[6~"
see {*8000 Hz*}
send -- "\t"
see {*操作菜单 · 按对应单键*}
send -- "t"
see {*second.wav*}
send -- "$archive\r"
see {*已切换目录*}
send -- "$media\r"
see {*已切换目录*}
send -- "WAV"
send -- "\r"
see {*Enter/Esc 返回*}
send -- "\033"
see {*媒体信息*}
send -- "\033"
finished
spawn -noecho /usr/bin/env PATH=$native TERM=xterm-256color /bin/zsh -f -c {stty rows 32 cols 110; source "$1/lib/aliases.zsh"; eval 'zidy "$2"'} zsh $root $media
see {*解压整理*}
send -- "$archive\r"
see {*已切换目录*}
send -- "\t"
see {*操作菜单 · 按对应单键*}
send -- "x"
see {*默认取消*}
send -- "\r"
see {*解压整理*}
if {![file exists "$archive/batch.zip"]} { puts stderr "Cancel changed ZIP input"; exit 1 }
send -- "\t"
see {*操作菜单 · 按对应单键*}
send -- "x"
see {*默认取消*}
send -- "\016\r"
see {*任务结束*}
send -- "\r"
see {*Enter/Esc 返回*}
if {[file exists "$archive/batch.zip"] || ![file exists "$archive/batch/测试.txt"]} {
    puts stderr "TUI ZIP execution did not finish as expected"; exit 1
}
send -- "\033"
see {*解压整理*}
send -- "\033"
finished
puts "PASS: hub and fzf tools in real PTY (preview, recursion, directory, cancel, ZIP execution, resize)"
